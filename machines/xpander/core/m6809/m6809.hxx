				dummy_read_opcode_arg(0);
				if (UNEXPECTED(m_icount <= 0)) { push_state(203); return; }
state_203:
				break;

			case 0x05: case 0x25: case 0x45: case 0x65:
			case 0x15: case 0x35: case 0x55: case 0x75:
