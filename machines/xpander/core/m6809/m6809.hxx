				dummy_read_opcode_arg(0);
				if (UNEXPECTED(m_icount <= 0)) { push_state(199); return; }
state_199:
				dummy_vma(2);
				if (UNEXPECTED(m_icount <= 0)) { push_state(200); return; }
state_200:
