	m_free_run = true;
	return;

X18:
	m_temp.b.l = read_opcode_arg(m_pc.w);
	if (UNEXPECTED(m_icount <= 0)) { push_state(229); return; }
state_229:
	m_temp.b.l = (m_cc & m_temp.b.l) << 1;
	m_cc = m_temp.b.l | ((m_cc & 0x04) >> 1);
	return;

XANDCC:
	eat(1);
	if (UNEXPECTED(m_icount <= 0)) { push_state(230); return; }
state_230:
	goto ANDCC;

XRES:
	set_ea(VECTOR_RESET_FFFE);
	debugger_exception_hook(EXCEPTION_XRES);
	set_regop16(m_s);
	m_temp.w = entire_state_registers();
	dummy_read_opcode_arg(0);
	if (UNEXPECTED(m_icount <= 0)) { push_state(231); return; }
