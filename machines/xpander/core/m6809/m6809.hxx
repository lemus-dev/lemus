state_242:
	m_temp.b.l = read_operand(1);
	if (UNEXPECTED(m_icount <= 0)) { push_state(243); return; }
state_243:
	set_flags(CC_NZVC, regop16().w, m_temp.w, regop16().w + m_temp.w);
