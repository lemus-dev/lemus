	if (m_temp.w & 0x01)
	{
		m_cc = read_memory(regop16().w++);
		if (UNEXPECTED(m_icount <= 0)) { push_state(182); return; }
state_182:
		nop();
	}
	if (m_temp.w & 0x02)
	{
