state_232:
	push_state(233);
	goto PUSH_REGISTERS;
state_233:
	goto INTERRUPT_VECTOR;

XNC8:
	if (m_cc & CC_C)
		goto COM8;
	else
		goto NEG8;

XDEC8:
	m_temp.b.l = read_operand();
