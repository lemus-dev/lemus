# The Virus C's core library (no JUCE): the 80C515, the board, the DSP56362 engine (core/dsp56300).
if(NOT TARGET lemus_viruscore)
  set(_vc ${VIRUSC_DIR}/core)
  file(GLOB _vc_engine CONFIGURE_DEPENDS ${_vc}/dsp56300/dsp56kBase/*.cpp ${_vc}/dsp56300/dsp56kEmu/*.cpp)
  list(FILTER _vc_engine EXCLUDE REGEX "(unittests|assemblertest|jitoptimizertests)\\.cpp$")
  file(GLOB_RECURSE _vc_asmjit CONFIGURE_DEPENDS ${_vc}/dsp56300/asmjit/src/asmjit/*.cpp)
  add_library(lemus_viruscengine STATIC ${_vc_engine} ${_vc_asmjit})
  target_include_directories(lemus_viruscengine SYSTEM PUBLIC ${_vc}/dsp56300 ${_vc}/dsp56300/asmjit/src)
  target_compile_definitions(lemus_viruscengine PUBLIC ASMJIT_STATIC DSP56300_DEBUGGER=0)
  target_compile_features(lemus_viruscengine PUBLIC cxx_std_17)
  set_target_properties(lemus_viruscengine PROPERTIES POSITION_INDEPENDENT_CODE ON)
  if(MSVC)
    # /permissive- as upstream builds it (dsp56300's base.cmake): without it MSVC finds the interpreter's
    # writeMem overloads ambiguous
    target_compile_options(lemus_viruscengine PRIVATE /O2 /W0 /constexpr:steps10000000 /permissive-)
  else()
    target_compile_options(lemus_viruscengine PRIVATE -O3 -w)
    if(UNIX AND NOT APPLE)
      target_compile_options(lemus_viruscengine PRIVATE -fconstexpr-loop-limit=10000000)
    endif()
  endif()

  add_library(lemus_viruscore STATIC ${_vc}/c515.cpp ${_vc}/hd44780.cpp ${_vc}/machine.cpp ${_vc}/resampler.cpp)
  get_filename_component(_vc_machines ${VIRUSC_DIR}/.. ABSOLUTE)
  target_include_directories(lemus_viruscore PUBLIC ${_vc_machines})
  target_link_libraries(lemus_viruscore PUBLIC lemus_viruscengine)
  find_package(Threads REQUIRED)
  target_link_libraries(lemus_viruscengine PUBLIC Threads::Threads)
  if(MSVC)
    target_compile_options(lemus_viruscore PRIVATE /O2 /W3)
  else()
    target_compile_options(lemus_viruscore PRIVATE -O3 -Wall -Wextra)
  endif()
  set_target_properties(lemus_viruscore PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()
