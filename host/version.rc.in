// Windows version info for a machine's own plugin, in place of the one JUCE writes
// (JUCE_USER_DEFINED_RC_FILE, CMakeLists.txt): the product is Lemus whatever the plugin is called,
// as SignPath's signing rules ask of every signed file, and the description names the plugin.
#undef  WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @_lemus_rc_version@
PRODUCTVERSION  @_lemus_rc_version@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName",     "Lemus\0"
      VALUE "FileDescription", "@_lemus_rc_name@\0"
      VALUE "FileVersion",     "@PROJECT_VERSION@\0"
      VALUE "InternalName",    "@_lemus_rc_name@\0"
      VALUE "ProductName",     "Lemus\0"
      VALUE "ProductVersion",  "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
