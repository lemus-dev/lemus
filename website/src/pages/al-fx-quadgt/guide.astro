// The plugin's view at its default size, 1255 × 154: the panel y 0–114 (2.6 px a millimetre),
// the bottom bar y 114–154. The top bar is the host's, above it, and isn't in the shots.
const base = { w: 1255, h: 154 };
// A box by its top-left corner and size in panel millimetres (machines/qvgt/docs/panel.json) as view pixels.
const mm = (x: number, y: number, w: number, h: number) => ({ x: x * 2.6, y: y * 2.6, w: w * 2.6, h: h * 2.6 });
// A key by its centre across and its row's top.
const key = (cx: number, top: number) => mm(cx - 7.55, top, 15.1, 5.7);
const at = {
  maker: mm(42.8, 1.6, 27.7, 4.9),
  name: mm(134.7, 1.5, 66.6, 8.4),
  input: mm(75.3 - 7.9, 24.2 - 7.9, 15.8, 15.8),
  lcd: mm(135.2, 11.5, 65.4, 20.0),
  value: mm(257.5 - 7.55, 15.0, 15.1, 21.0),
  prog: key(291.0, 15.0),
  store: key(291.0, 30.3),
  power: mm(425.8, 8.6, 16.4, 6.2),
};
// The rear's jacks, a group at a time: from the first's left edge to the last's right.
const jacks = (a: number, b: number) => mm(a - 8.5, 9.1, b - a + 17, 17);

// The sections and their headings, for the contents at the top and the sidebar. Keep in step
// with the ids and headings below.
type Entry = { id: string; title: string; sub?: Entry[] };
const toc: Entry[] = [
  { id: 'start', title: 'Getting started', sub: [
    { id: 'first-start', title: 'The first start' },
    { id: 'roms', title: 'The ROMs' },
    { id: 'artwork', title: 'Panel artwork' },
    { id: 'first-sound', title: 'Your first sound' },
  ] },
  { id: 'panel', title: 'The panel', sub: [
    { id: 'memory', title: 'Programs and memory' },
    { id: 'force', title: 'Key force' },
    { id: 'levels', title: 'INPUT and the LEDs' },
    { id: 'power', title: 'POWER' },
  ] },
  { id: 'rear', title: 'The rear', sub: [
    { id: 'audio', title: 'INPUT and OUTPUT' },
    { id: 'effects-loop', title: 'EFFECTS' },
    { id: 'footswitches', title: 'Footswitches' },
  ] },
  { id: 'bars', title: 'The bars', sub: [
    { id: 'top-bar', title: 'The top bar' },
    { id: 'state', title: 'State' },
    { id: 'bottom-bar', title: 'The bottom bar' },
  ] },
  { id: 'midi', title: 'MIDI and your DAW', sub: [
    { id: 'midi-in', title: 'MIDI in' },
    { id: 'midi-out', title: 'MIDI out' },
    { id: 'automation', title: 'Automation and sessions' },
  ] },
  { id: 'keyboard', title: 'Keyboard and mouse', sub: [
    { id: 'keys', title: 'Computer keys' },
    { id: 'mouse', title: 'Mouse' },
  ] },
