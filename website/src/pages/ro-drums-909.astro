---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MachineTop from '../components/MachineTop.astro';
import SampleList from '../components/SampleList.astro';
import { bySlug } from '../data/machines';
import voiceModeShot from '../assets/ro-drums-909/voice-mode.webp';
import serviceShot from '../assets/ro-drums-909/service.webp';

const m = bySlug('ro-drums-909');
const voiceMode = await getImage({ src: voiceModeShot, format: 'webp', quality: 85 });
const service = await getImage({ src: serviceShot, format: 'webp', quality: 85 });

// The real unit: a video of a TR-909 playing its factory song. Linked, never hosted.
const video = 'https://www.youtube.com/watch?v=od-erpCKbtc';

// The strip under the header: the page's sections, the one being read underlined.
const sections = [
  { id: 'download', label: 'Download' },
  { id: 'hear', label: 'Hear it' },
  { id: 'accuracy', label: 'In numbers' },
  { id: 'service', label: 'Service' },
  { id: 'revisions', label: 'Board revisions' },
  { id: 'differences', label: 'Differences' },
  { id: 'made', label: 'How it was made' },
  { id: 'roland', label: "Roland's software" },
  { id: 'rom', label: 'ROMs' },
  { id: 'artwork', label: 'Artwork' },
];

// A scale for the In numbers charts: where a value sits, as a percentage of the axis.
const at = (v: number, min: number, max: number) => `${((v - min) / (max - min)) * 100}%`;
const width = (from: number, to: number, min: number, max: number) => `${((to - from) / (max - min)) * 100}%`;
const ticks = (min: number, max: number, step: number, label: (v: number) => string) =>
  Array.from({ length: Math.round((max - min) / step) + 1 }, (_, i) => min + i * step).map((v) => ({ left: at(v, min, max), label: label(v) }));
const cents = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v) + ' ¢';
---
<Base title="ro-drums-909 · Lemus" description="ro-drums-909 emulates the Roland TR-909 Rhythm Composer: its original sequencer firmware on an emulated CPU, and its voicing board modelled part by part. Free for macOS and Windows." current="ro-drums-909">

<nav slot="sub" class="onpage" aria-label="On this page">
<div class="frame sheet">
<div class="col">
<ol>
{sections.map((s) => <li><a href={`#${s.id}`} class:list={{ red: s.id === 'differences' }}>{s.label}</a></li>)}
</ol>
</div>
</div>
</nav>

<MachineTop machine={m}>
<SampleList heading="Factory song and patterns" plugin="ro-drums-909" link={{ href: video, text: 'A real TR-909 playing the song, on YouTube' }} tracks={[
  { src: '/media/ro-drums-909/factory-song.m4a', title: 'Factory song', detail: 'TRACK 1, TEMPO 110.3' },
  ...[1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({ src: `/media/ro-drums-909/factory-pattern-${n}.m4a`, title: `Pattern ${n}` })),
]} />
<Fragment slot="data">
<div><dt class="lbl">ROM images</dt><dd><span class="mono">tr909_v4.ic609</span> and the hi-hat, crash and ride ROMs, not included</dd></div>
<div><dt class="lbl">Outputs</dt><dd>Master L and R, ten MULTI OUTs</dd></div>
</Fragment>
</MachineTop>

