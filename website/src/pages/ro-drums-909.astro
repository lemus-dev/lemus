<div class="dim small">The real unit: 14.4 ms. Roland's TR-909 software: 20.9 ms, 45 % long.</div>
</div>
<div class="chart" aria-hidden="true">
<div class="axis"></div>
{ticks(0, 30, 5, (v) => `${v} ms`).map((t) => <><span class="tick" style={`left: ${t.left}`}></span><span class="tick-label" style={`left: ${t.left}`}>{t.label}</span></>)}
