<span class="zero" style={`left: ${at(0, -150, 50)}`}></span>
<span class="label ours to-end" style={`left: ${at(21, -150, 50)}; top: 0`}>ro-drums-909 −21 to +21 ¢</span>
<span class="span ours" style={`left: ${at(-21, -150, 50)}; width: ${width(-21, 21, -150, 50)}; top: 18px`}></span>
<span class="label" style={`left: ${at(-118, -150, 50)}; top: 32px`}>Roland's software −118 to −29 ¢</span>
