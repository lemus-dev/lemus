---
import Base from '../layouts/Base.astro';
import MachineTop from '../components/MachineTop.astro';
import SampleList from '../components/SampleList.astro';
import { bySlug } from '../data/machines';

const m = bySlug('ro-mono-101');

// The strip under the header: the page's sections, the one being read underlined.
const sections = [
  { id: 'download', label: 'Download' },
  { id: 'hear', label: 'Hear it' },
  { id: 'accuracy', label: 'In numbers' },
  { id: 'differences', label: 'Differences' },
  { id: 'made', label: 'How it was made' },
  { id: 'roland', label: "Roland's software" },
  { id: 'rom', label: 'ROM' },
  { id: 'artwork', label: 'Artwork' },
];

// A scale for the In numbers chart: where a value sits, as a percentage of the axis.
const at = (v: number, min: number, max: number) => `${((v - min) / (max - min)) * 100}%`;
const ticks = (min: number, max: number, step: number, label: (v: number) => string) =>
  Array.from({ length: Math.round((max - min) / step) + 1 }, (_, i) => min + i * step).map((v) => ({ left: at(v, min, max), label: label(v) }));
// The ENV sweep chart: one row per source, the axis under them.
const oct = (v: number) => at(v, 7, 8);
const row = (i: number) => i * 28;

// The real units in the clips, on YouTube.
const video = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---
<Base title="ro-mono-101 · Lemus" description="ro-mono-101 emulates the Roland SH-101: its original sequencer and arpeggio firmware on an emulated CPU, and its synth board modelled part by part. Free for macOS and Windows." current="ro-mono-101">

<nav slot="sub" class="onpage" aria-label="On this page">
<div class="frame sheet">
<div class="col">
<ol>
{sections.map((s) => <li><a href={`#${s.id}`} class:list={{ red: s.id === 'differences' }}>{s.label}</a></li>)}
</ol>
</div>
</div>
</nav>

<MachineTop machine={m}>
<SampleList heading="At real units' settings" plugin="ro-mono-101" tracks={[
  { src: '/media/ro-mono-101/env-saw.m4a', title: 'ENV sweep', detail: 'RES 0, ENV 10, A/D/S/R 10' },
  { src: '/media/ro-mono-101/env-selfosc.m4a', title: 'Self-oscillation', detail: 'RES 10, ENV 10, A/D/S/R 10' },
  { src: '/media/ro-mono-101/ping.m4a', title: 'Ping', detail: 'FREQ 5, RES 10, ENV 5' },
  { src: '/media/ro-mono-101/portamento.m4a', title: 'Portamento', detail: 'PORTAMENTO 10, switch ON' },
]} />
<Fragment slot="data">
<div><dt class="lbl">ROM image</dt><dd><span class="mono">tmp80c49p-6-7301.ic6</span>, not included</dd></div>
</Fragment>
</MachineTop>

<section class="sheet">
<div class="col sec">
<figure class="panel">
<div class="mount">
<div class="pin">
<img src="/media/ro-mono-101/voice-mode.png" alt="ro-mono-101 in voice mode: the SH-101 panel with its sliders, switches, buttons, bender and 32 keys, its brand marks' places left blank, and the plugin bar with SYNC and ?" width="1200" height="691">
<span class="leader" style="left: 66.5%; top: -24px; height: calc(26% + 24px)" aria-hidden="true"></span>
<span class="target" style="left: 66.5%; top: 26%" aria-hidden="true"></span>
<span class="balloon" style="left: 66.5%; top: -56px" aria-hidden="true">A2</span>
<span class="leader" style="left: 28%; top: 42%; height: calc(58% + 24px)" aria-hidden="true"></span>
<span class="target" style="left: 28%; top: 42%" aria-hidden="true"></span>
<span class="balloon" style="left: 28%; top: calc(100% + 24px)" aria-hidden="true">A1</span>
</div>
</div>
<figcaption class="caption">
<div class="row"><span class="key">A1</span><span><strong>Sequencer and arpeggio.</strong> The CPU, IC6, runs its original program from <span class="mono">tmp80c49p-6-7301.ic6</span>.</span></div>
<div class="row"><span class="key">A2</span><span><strong>Synth board.</strong> Modelled part by part from the service notes.</span></div>
<div class="row"><span class="fig">FIG. 1</span><span>Voice mode: the panel with its brand marks' places left blank, and the plugin bar with SYNC and ?.</span></div>
</figcaption>
</figure>
</div>
</section>

<section id="accuracy" class="sheet">
<div class="col sec">
<div class="numbers-head">
<h2 class="h2 tap">In numbers</h2>
<p class="dim">Checked against recordings of nine real SH-101s, an ngspice simulation of the transcribed schematic and the service notes' own checks. Method: <a href="#made">How it was made</a>.</p>
<p class="dim small">The clips at the top: ro-mono-101 alone, with no effects, at the settings read off videos of three real units: <a href={video('eStzYAZoOAI')}>Friendly Noise's</a> for the ENV sweeps (the unit ro-mono-101 is calibrated to), <a href={video('6NqaegXGbtE')}>Failed Muso's</a> for the ping, the filter alone with the sources off, and <a href={video('PFXO4ZRsVC4')}>Once Upon a Synth's</a> for the portamento. The ping's video gives FREQ, RES and ENV; DECAY and SUSTAIN are inferred from the recording. For the portamento, FREQ is 3.8 where the video reads 2.6: that unit is about 1.2 octaves brighter than ro-mono-101 at the same settings.</p>
</div>

<div class="numbers">
<div class="measure">
<div class="figure">
<div class="big">7.28</div>
<div class="what">octaves swept by ENV 10; the real unit's, 7.27</div>
<div class="dim small">Friendly Noise's unit, which ro-mono-101 is calibrated to. Against a second unit, in two takes: each within 0.11 octave. Roland's SH-101 software sweeps 7.65; the schematic as transcribed, 7.7 or more (<a href="#differences">Differences</a>).</div>
</div>
<div class="chart dots" aria-hidden="true">
<span class="drop" style={`left: ${oct(7.28)}; top: ${row(0) + 8}px`}></span>
<span class="dot ours" style={`left: ${oct(7.28)}; top: ${row(0) + 8}px`}></span>
<span class="label ours right" style={`left: ${oct(7.28)}; top: ${row(0)}px`}>ro-mono-101 7.28</span>
<span class="drop" style={`left: ${oct(7.27)}; top: ${row(1) + 8}px`}></span>
<span class="dot" style={`left: ${oct(7.27)}; top: ${row(1) + 8}px`}></span>
<span class="label right" style={`left: ${oct(7.27)}; top: ${row(1)}px`}>real unit 7.27</span>
<span class="drop" style={`left: ${oct(7.65)}; top: ${row(2) + 8}px`}></span>
<span class="dot" style={`left: ${oct(7.65)}; top: ${row(2) + 8}px`}></span>
<span class="label left" style={`left: ${oct(7.65)}; top: ${row(2)}px`}>Roland's software 7.65</span>
<span class="drop" style={`left: ${oct(7.7)}; top: ${row(3) + 8}px`}></span>
<span class="span" style={`left: ${oct(7.7)}; width: calc(100% - ${oct(7.7)}); top: ${row(3) + 3}px`}></span>
<span class="label left" style={`left: ${oct(7.7)}; top: ${row(3)}px`}>schematic: 7.7 or more</span>
<div class="axis"></div>
{ticks(7, 8, 0.2, (v) => v.toFixed(1)).map((t) => <><span class="tick" style={`left: ${t.left}`}></span><span class="tick-label" style={`left: ${t.left}`}>{t.label}</span></>)}
</div>
</div>

<div class="measure">
<div class="figure">
<div class="big">0.11 dB</div>
<div class="what">the whole voice's level against ngspice, filter open</div>
<div class="dim small">Every block of the transcribed schematic joined into one circuit, from the VCO to the OUTPUT jack, 43 cases: harmonics within 0.33 dB, the filter's cutoff within 4 cents and its self-oscillation within 9 cents, the ENV to the VCA within 0.05 dB. Each block alone: 28 of 28 checks within their limits.</div>
</div>
</div>

<div class="measure">
<div class="figure">
<div class="big">34 / 34</div>
<div class="what">service-note checks passed</div>
<div class="dim small">Every adjustment and specification in the service notes: the D/A in test mode, through the firmware; VCO TUNE, WIDTH and RANGE WIDTH, through the whole machine; VCF WIDTH; the cutoff, ENV, LFO, portamento, PWM, TUNE and output ranges; the sub-oscillator's waveforms.</div>
</div>
</div>
</div>
</div>
</section>

<section id="differences" class="sheet">
<div class="col sec">
<h2 class="h2 tap red">What is still different</h2>
<dl class="diffs">
<div><dt>The ENV's depth</dt><dd>As transcribed, the schematic can't sweep less than 7.7 octaves at ENV 10 while KYBD tracks. Two real units sweep about 7.2, Roland's software 7.65. ro-mono-101 scales the ENV's weight at the cutoff to 0.82 of the schematic's to match. The measurement, the tracking, the chip's law, the parts on that path and the VCA switch are ruled out; the cause isn't known.</dd></div>
<div><dt>Units differ</dt><dd>In FREQ and RES. The service notes trim the filter's keyboard tracking, not where its cutoff sits. Once Upon a Synth's unit is about 1.2 octaves brighter than ro-mono-101 at the same settings, loopop's lower and more resonant. AutomaticGainsay's FREQ reads 5–8 % steeper per division, and its top RES reading sits 0.4 division past ours.</dd></div>
<div><dt>The filter chip</dt><dd>The IR3109 has no maker's data. It is modelled from Open Music Labs' decode and the AS3109 data sheet, with its law end to end from one Juno-106 voice. Its expo current is fitted to a real unit, at 1.7 times the decode's; its buffers' gain, 0.89–0.96, is uncertain by a few percent.</dd></div>
<div><dt>Noise</dt><dd>The schematic gives neither its level nor its colour. Both are set from real units, whose levels spread 2.7 dB.</dd></div>
<div><dt>Switching off and on</dt><dd>At POWER off, +9 V is taken to fall with a 12 ms time constant, an estimate. The thump follows it: −41 dBFS, −30 for a 5 ms fall, under −45 for 25 ms. The mute at POWER on is the circuit's. Neither has been compared with a recording.</dd></div>
</dl>
<div class="not">
<h3 class="h3">Not emulated</h3>
<p class="dim">CV/GATE in and out; the EXT CLK jack (SYNC stands in); the HOLD jack (CC 64 stands in); PHONES; the battery (the memory always keeps the sequence); the MGS-1 grip's own controls, beyond the lever's push.</p>
</div>
<div id="help" class="help">
<div class="help-text">
<h3 class="h3">Own an SH-101?</h3>
<p>Recordings or measurements of a real unit at known settings settle these: the cutoff at several FREQ positions, a RES series, where self-oscillation starts, the voltages at IC18b's inputs at ENV 10.</p>
</div>
<a href="https://lemus.discourse.group" class="btn red">The forum</a>
</div>
</div>
</section>

<section id="made" class="sheet">
<div class="col sec">
<h2 class="h2 tap">How it was made</h2>
<ol class="steps">
<li>
<div class="step-n">01</div>
<div class="step">
<h3 class="h3">Schematic and SPICE</h3>
<p class="dim">The synth board was transcribed from the service notes' schematic and modelled part by part: portamento, the pitch summer and the bender board, the CEM3340 VCO and the 4013 sub-oscillator, the noise source and the mixer, the MODULATOR, the IR3109 VCF with its resonance loop, the discrete ENV generator, the BA662A VCA, the output stage and jack board A's mute. Each block was compared with an ngspice simulation of the same transcription in 28 checks: against the VCF with the IR3109 at transistor level, the model is within 0.09 dB small-signal and self-oscillates within 6 cents up to 1 kHz. Then every block was joined into one circuit (<a href="#accuracy">In numbers</a>). All 34 of the service notes' adjustments and specifications pass.</p>
</div>
</li>
<li>
<div class="step-n">02</div>
<div class="step">
<h3 class="h3">Real boards</h3>
<p class="dim">Part values were read from the parts list of a dismantled unit (Din Sync), photos of six other units' boards and the service notes' own board diagram. They corrected four of the modulator's resistors to 100k (R169, R188, R31 and R35), and put R196 on S6's side of R197, which is why a real unit's VCA fades with the ENV to the end. A real unit's square LFO swings 0.74 of its triangle, as R31 at 100k gives.</p>
</div>
</li>
<li>
<div class="step-n">03</div>
<div class="step">
<h3 class="h3">Calibration to real units</h3>
<p class="dim">The service notes trim the unit but leave values open: the IR3109 has no data sheet of its own, the ENV pots are ±20 %, and the schematic's ENV sweeps too far (<a href="#differences">Differences</a>). The Real unit calibration, the one ro-mono-101 plays, takes them from recordings: Friendly Noise's unit, its sliders read off 1080p video, for where FREQ 0 sits and the ENV's sweep and times; another unit for the portamento. The first column is the unit as the service notes trim it, with nominal parts and the data sheets' values.</p>
<div class="table-box">
<table class="table fitted">
<thead><tr><th scope="col">Part</th><th scope="col">Service notes</th><th scope="col" class="fit">Real unit</th></tr></thead>
<tbody>
<tr><td>VCO tuning, A4</td><td class="num dim">442 Hz</td><td class="num fit">440 Hz</td></tr>
<tr><td>IR3109 expo slope</td><td class="num dim">19.0 mV/oct</td><td class="num fit">20.8 mV/oct, measured on an original chip</td></tr>
<tr><td>IR3109 expo current</td><td class="num dim">2.4 µA</td><td class="num fit">5.0 µA</td></tr>
<tr><td>ENV's weight at the cutoff</td><td class="num dim">1.0</td><td class="num fit">0.82</td></tr>
<tr><td>ENV pots</td><td class="num dim">nominal</td><td class="num fit">0.9 × nominal</td></tr>
<tr><td>Portamento τ at 10</td><td class="num dim">0.66 s</td><td class="num fit">0.78 s, another unit's</td></tr>
<tr class="total"><td>ENV 10's sweep</td><td class="num">7.7 octaves or more</td><td class="num fit">7.28 octaves; the unit's 7.27</td></tr>
</tbody>
</table>
</div>
<p class="dim small">Then nine real units, per unit and per event, in 105 measurements: 60 within their limits, 4 known gaps (<a href="#differences">Differences</a>), 41 for information. A second unit needs the same ENV weight; the portamento's top matches another within 0.01 s; the square and subs against the saw are within 1 dB on every note of three units; the noise's colour fits three. Twelve of the recordings, A/B against ro-mono-101 at the same settings, changed nothing: every difference heard was a setting or timing misread, the recording, or unit spread.</p>
</div>
</li>
<li>
<div class="step-n">04</div>
<div class="step">
<h3 class="h3">The firmware</h3>
<p class="dim">The TMP80C49P-6-7301's program runs from reset on an emulated MCS-48 (ported from MAME's core) with the SH-101's key matrix, switch columns, 6-bit DAC and sample-and-holds, sample by sample at the host rate, so its 1.1–3.7 ms loop is the hardware's. The 100-step sequencer, the arpeggio, note priority and KEY TRANSPOSE are the original program's. A self-test runs the ROM through the service notes' test-mode table, the sequence format, PLAY, the arpeggio, key priority, KEY TRANSPOSE, the clock and RANDOM.</p>
</div>
</li>
</ol>
</div>
</section>

<section id="roland" class="sheet">
<div class="col sec">
<div class="text">
<h2 class="h2 tap">Roland's SH-101 software</h2>
<p class="dim">Not a reference, but the obvious comparison: 205 tests, each rendered through Roland's SH-101 plug-in and through ro-mono-101 at the same settings, compared by log-spectral distance. ro-mono-101 plays the Real unit calibration above. A second calibration, fitted to Roland's plug-in, is kept for this comparison; it isn't in the plugin.</p>
</div>
<div class="table-box">
<table class="table versus">
<caption>Mean log-spectral distance from Roland's plug-in in dB, by group (tests). Lower is closer.</caption>
<thead><tr><th scope="col">Calibration</th><th scope="col">VCF (34)</th><th scope="col">VCA (2)</th><th scope="col">Mixer (11)</th><th scope="col">ENV (35)</th><th scope="col">Self-osc. (40)</th><th scope="col">Oscillator (24)</th><th scope="col">LFO (24)</th><th scope="col">Portamento (10)</th><th scope="col">All (205)</th></tr></thead>
<tbody>
<tr class="dim"><th scope="row">Fitted to Roland's</th><td class="num">2.7</td><td class="num">3.5</td><td class="num">4.0</td><td class="num">3.5</td><td class="num">5.1</td><td class="num">5.2</td><td class="num">10.9</td><td class="num">10.3</td><td class="num">5.5</td></tr>
<tr class="ours"><th scope="row">Real unit, <span class="mono">ro-mono-101</span></th><td class="num">4.0</td><td class="num">3.8</td><td class="num">4.2</td><td class="num">4.0</td><td class="num">5.5</td><td class="num">5.6</td><td class="num">12.1</td><td class="num">10.7</td><td class="num">6.1</td></tr>
<tr><th scope="row">Service notes</th><td class="num">4.4</td><td class="num">4.3</td><td class="num">9.0</td><td class="num">11.4</td><td class="num">5.7</td><td class="num">9.3</td><td class="num">11.0</td><td class="num">14.6</td><td class="num">8.7</td></tr>
</tbody>
</table>
</div>
<p class="dim">The Real unit calibration follows the real units' brighter filter top, where Roland's plug-in is darker. Most of the service notes' distance is their 442 Hz tuning. A parts-spread study, 20,000 simulated units with every part within its tolerance and every trim redone, shows where Roland's plug-in goes beyond what a unit does (real units: the middle 90 %):</p>
<div class="table-box">
<table class="table beyond">
<thead><tr><th scope="col"><span class="sr">Measure</span></th><th scope="col">Roland's plug-in</th><th scope="col"><span class="mono">ro-mono-101</span></th><th scope="col">Real units</th></tr></thead>
<tbody>
<tr><th scope="row">Portamento τ at 10</th><td class="num">1.55 s</td><td class="num">0.78 s</td><td>0.53–0.80 s; one recorded unit 0.78 s</td></tr>
<tr><th scope="row">FREQ, octaves per division</th><td>1.23, straight</td><td>1.1–1.7, bending upward</td><td>Bending on every unit: the FREQ pot is a linear 100k loaded by R186, 200k</td></tr>
<tr><th scope="row">KYBD's pivot</th><td>Near MIDI note 12</td><td>The key CV: 0 V at C2, TRANSPOSE M</td><td>The key CV: one recorded unit's rest fits it</td></tr>
</tbody>
</table>
</div>
<p class="dim small">Measured with Roland's SH-101 plug-in 1.2.0.</p>
</div>
</section>

<section id="rom" class="sheet">
<div class="col sec brief">
<h2 class="h2 tap">ROM image and voice mode</h2>
<p class="dim">The sequencer, arpeggio and keyboard program is in the CPU's 2 KB mask ROM, Roland's copyrighted work, so it isn't included. MAME has no SH-101 set; the image ro-mono-101 takes, <span class="mono">tmp80c49p-6-7301.ic6</span>, is the dump published with the SH101_Disassembled project on GitHub. With it, ro-mono-101 runs the program on an emulated CPU. Without it, ro-mono-101 runs in voice mode: the same synth board over MIDI, with no sequencer or arpeggio. <a href="/ro-mono-101/guide#first-start">The ROM and voice mode</a></p>
</div>
</section>

<section id="artwork" class="sheet">
<div class="col sec brief last">
<h2 class="h2 tap">Panel artwork</h2>
<p class="dim">Roland's logo and the SH-101 logo are trademarks, so their two places on the panel are blank. Each place takes an SVG or PNG file of your own, named <span class="mono">ro-mono-101-maker</span> and <span class="mono">ro-mono-101-model</span>, in the ROM folder: drawn yourself, or generated with an AI tool such as Claude or ChatGPT. <a href="/ro-mono-101/guide#artwork">Panel artwork</a></p>
</div>
</section>

</Base>

<script>
// Underline the strip's link for the section being read: the last whose top has passed under the
// strip, or the last of all at the foot of the page.
const links = [...document.querySelectorAll<HTMLAnchorElement>('.onpage a')];
const targets = links.map((a) => document.getElementById(a.hash.slice(1))!);
const strip = document.querySelector<HTMLElement>('.onpage ol')!;
let current = -2;
function mark() {
  let i = -1;
  targets.forEach((t, j) => { if (t.getBoundingClientRect().top <= 80) i = j; });
  if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) i = targets.length - 1;
  if (i === current) return;
  current = i;
  links.forEach((a, j) => { if (j === i) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
  // Bring the link into view along the strip only. scrollIntoView would also scroll the page, up
  // by the scroll padding, since the stuck strip sits inside it.
  const a = links[i];
  if (!a) return;
  const r = a.getBoundingClientRect(), s = strip.getBoundingClientRect();
  if (r.left < s.left) strip.scrollLeft += r.left - s.left;
  else if (r.right > s.right) strip.scrollLeft += r.right - s.right;
}
let frame = 0;
const later = () => { if (!frame) frame = requestAnimationFrame(() => { frame = 0; mark(); }); };
addEventListener('scroll', later, { passive: true });
addEventListener('resize', later);
mark();
</script>

