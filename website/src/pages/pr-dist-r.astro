.caption .mono { font-size: 13px; color: var(--ink); }

.text { display: flex; flex-direction: column; gap: 18px; min-width: 0; max-width: 48em; }
.text p { margin: 0; }
.small { font-size: 15px; }
.tiny { font-size: 13px; }
.mono { font-size: 0.9em; color: var(--ink); }

.numbers-head { display: flex; flex-direction: column; gap: 18px; }
.numbers-head p { margin: 0; font-size: 16px; }
.numbers { display: flex; flex-direction: column; margin-top: -8px; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
