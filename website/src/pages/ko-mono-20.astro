.onpage ol::-webkit-scrollbar { display: none; }
.onpage a { display: inline-flex; align-items: center; min-height: 46px; box-sizing: border-box; padding-top: 3px; border-bottom: 3px solid transparent; color: var(--ink2); text-decoration: none; font-size: 15px; font-weight: 500; }
.onpage a:hover { color: var(--ink); }
.onpage a[aria-current] { color: var(--ink); border-bottom-color: var(--wire); }
.onpage a.red[aria-current] { border-bottom-color: var(--red); }

