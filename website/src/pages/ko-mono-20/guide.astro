---
<Base title="ko-mono-20 user guide · Lemus" description="How to use ko-mono-20: panel artwork, the panel and the patch panel, POWER OFF, the Rev 1 and Rev 2 filter boards, MIDI, audio in from your DAW, sessions and the computer keys." current="ko-mono-20">

<div class="sheet">
<div class="col guide">

<!-- Beside the guide on a wide window; on a narrow one, a drawer behind the Contents button. -->
<nav class="side" id="contents" aria-label="Contents">
<div class="label">Contents</div>
<ol>
{toc.map((s, i) => (
<li>
<a href={`#${s.id}`} class="top"><span class="n">{i + 1}</span>{s.title}</a>
{s.sub && <ol>
{s.sub.map((h) => (
<li>
<a href={`#${h.id}`}>{h.title}</a>
{h.sub && <ol>{h.sub.map((g) => <li><a href={`#${g.id}`} class="deep">{g.title}</a></li>)}</ol>}
</li>
))}
</ol>}
</li>
))}
</ol>
</nav>
