---
import Base from '../layouts/Base.astro';
import Prerelease from '../components/Prerelease.astro';
import MailForm from '../components/MailForm.astro';
import Clip from '../components/Clip.astro';
import { bySlug, downloadLinks, platforms, sourceOf } from '../data/machines';

const m = bySlug('ro-mono-303');
const links = downloadLinks(m);

// The strip under the header: the page's sections, the one being read underlined.
const sections = [
  { id: 'accuracy', label: 'Hear it' },
  { id: 'service', label: 'Service' },
  { id: 'differences', label: 'Differences' },
  { id: 'made', label: 'How it was made' },
  { id: 'roland', label: "Roland's software" },
  { id: 'rom', label: 'ROM' },
];

// A scale for the In numbers charts: where a value sits, as a percentage of the axis.
const at = (v: number, min: number, max: number) => `${((v - min) / (max - min)) * 100}%`;
const ticks = (min: number, max: number, step: number, label: (v: number) => string) =>
  Array.from({ length: Math.round((max - min) / step) + 1 }, (_, i) => min + i * step).map((v) => ({ left: at(v, min, max), label: label(v) }));
const cents = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v) + ' ¢';
---
<Base title="ro-mono-303 · Lemus" description="ro-mono-303 emulates the Roland TB-303 Bass Line: its original sequencer firmware on an emulated CPU, and its voice circuit modelled part by part. Free for macOS and Windows." current="ro-mono-303">

<nav slot="sub" class="onpage" aria-label="On this page">
<div class="frame sheet">
<div class="col">
<ol>
{sections.map((s) => <li><a href={`#${s.id}`} class:list={{ red: s.id === 'differences' }}>{s.label}</a></li>)}
</ol>
</div>
</div>
</nav>

<section class="sheet">
<div class="col hero">
<div class="top">
<div class="intro">
<nav aria-label="Breadcrumb" class="crumbs"><a href="/#plugins">Plugins</a> / ro-mono-303</nav>
<h1 class="name">ro-mono-303</h1>
<p class="lede">Emulation of the Roland TB-303 Bass Line (1981), a monophonic bass synthesizer with a built-in step sequencer.</p>
<p class="dim">It runs the original sequencer firmware on an emulated CPU, and models the voice circuit part by part from the service notes.</p>
<div class="buttons">
<a href={links.mac} class="btn">Download for macOS</a>
<a href={links.windows} class="btn">Download for Windows</a>
</div>
<p class="meta">Free{m.release && <>, version {m.release.version}{m.release.stage && ` ${m.release.stage}`}, source: <a href={sourceOf(m.release)}>v{m.release.version} on GitHub</a> (GNU AGPLv3)</>}</p>
{m.release && <Prerelease release={m.release} />}
<div class="mailbox tapbox">
<h2 class="mail-h">Release announcements by email</h2>
<p class="dim">An email when a machine or a new version is released, and nothing else. Every email has an unsubscribe link.</p>
<MailForm id="mail-hero" />
</div>
<div class="jumps">
<a href="/ro-mono-303/guide">User guide</a>
<a href="#accuracy">Hear it next to a real TB-303
<svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M8 2v11M4 9l4 4 4-4"></path></svg></a>
</div>
</div>

<div class="data">
<div class="data-head"><span>Data</span>{m.release && <span class="mono">{m.slug} {m.release.version}</span>}</div>
<dl>
<div><dt class="lbl">Emulates</dt><dd>Roland TB-303 Bass Line</dd></div>
<div><dt class="lbl">Year</dt><dd>{m.year}</dd></div>
<div><dt class="lbl">Type</dt><dd>{m.type}</dd></div>
<div><dt class="lbl">Status</dt><dd class={m.status === 'working' ? 'ok' : 'partial'}>{m.status}</dd></div>
<div><dt class="lbl">Without ROM</dt>{m.withoutRom === 'voice' ? <dd class="partial"><span class="mono">[~]</span> voice mode</dd> : <dd class="missing"><span class="mono">[✗]</span> ROM missing</dd>}</div>
<div><dt class="lbl">ROM image</dt><dd><span class="mono">d650c-133.ic8</span>, not included</dd></div>
{platforms.map(([os, formats]) => <div><dt class="lbl">{os}</dt><dd>{formats}</dd></div>)}
</dl>
</div>
</div>

<figure class="panel">
<div class="mount">
<div class="pin">
<img src="/media/ro-mono-303/voice-mode.png" alt="ro-mono-303 in voice mode: the TB-303 panel with knobs, switches and keys, its brand mark slots left blank, and the plugin bar with SYNC, CUT OFF MAX and SERVICE" width="1200" height="640">
<span class="leader" style="left: 40.8%; top: -24px; height: calc(15% + 24px)" aria-hidden="true"></span>
<span class="target" style="left: 40.8%; top: 15%" aria-hidden="true"></span>
<span class="balloon" style="left: 40.8%; top: -56px" aria-hidden="true">A2</span>
<span class="leader" style="left: 59%; top: 74%; height: calc(26% + 24px)" aria-hidden="true"></span>
<span class="target" style="left: 59%; top: 74%" aria-hidden="true"></span>
<span class="balloon" style="left: 59%; top: calc(100% + 24px)" aria-hidden="true">A1</span>
</div>
</div>
<figcaption class="caption">
<div class="row"><span class="key">A1</span><span><strong>Sequencer.</strong> The CPU, IC8, runs its original program from <span class="mono">d650c-133.ic8</span>.</span></div>
<div class="row"><span class="key">A2</span><span><strong>Voice.</strong> Modelled part by part from the service notes.</span></div>
<div class="row"><span class="fig">FIG. 1</span><span>Voice mode: the panel with its brand mark slots left blank, and the plugin bar with SYNC, CUT OFF MAX and SERVICE.</span></div>
</figcaption>
</figure>
</div>
</section>

<section id="accuracy" class="sheet">
<div class="col sec">
<div class="pair">
<div class="text">
<h2 class="h2 tap">Next to a real TB-303</h2>
<p class="dim">acidvoice.com has recordings of a real TB-303 playing an accent test at three knob settings. These are ro-mono-303 playing the same pattern at the same settings, with no effects.</p>
<a href="https://www.acidvoice.com/tb-3-vs-tb-303.htm" class="btn ghost small out">The real TB-303 on acidvoice.com
<svg aria-hidden="true" width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M6 3h7v7M13 3L4 12"></path></svg></a>
<p class="dim small">ro-mono-303 is set to match that unit: CUT OFF MAX <span class="mono">2.05 kHz</span> and DECAY <span class="mono">65 %</span> (the site doesn't give DECAY).</p>
</div>
<div class="clips">
<Clip src="/media/ro-mono-303/acidvoice-303_100.m4a" settings={[['CUT OFF', '100 %'], ['RESONANCE', '100 %'], ['ACCENT', '100 %']]} note="ro-mono-303 at RESONANCE 98 %, matched to that unit by ear" />
<Clip src="/media/ro-mono-303/acidvoice-303_60.m4a" settings={[['CUT OFF', '60 %'], ['RESONANCE', '100 %'], ['ACCENT', '100 %']]} note="ro-mono-303 at CUT OFF 51 %, where its filter sits where that unit's does at 60 %" />
<Clip src="/media/ro-mono-303/acidvoice-303_0_0.m4a" settings={[['CUT OFF', '0 %'], ['RESONANCE', '0 %'], ['ACCENT', '100 %']]} />
</div>
</div>

<div class="numbers-head">
<h3 class="h3">In numbers</h3>
<p class="dim">Measured note by note against 400 notes recorded from a real TB-303. Method: <a href="#made">How it was made</a>.</p>
</div>

<div class="numbers">
<div class="measure">
<div class="figure">
<div class="big">4.89</div>
<div class="what">distance from the real unit, lower is closer</div>
<div class="dim small">Two takes of the real unit differ by 2.39. The schematic values alone score 9.76.</div>
</div>
<div class="chart" aria-hidden="true">
<div class="axis"></div>
{ticks(0, 10, 2, String).map((t) => <><span class="tick" style={`left: ${t.left}`}></span><span class="tick-label" style={`left: ${t.left}`}>{t.label}</span></>)}
<span class="bar" style={`width: ${at(4.89, 0, 10)}`}></span>
<span class="dot ours" style={`left: ${at(4.89, 0, 10)}`}></span>
<span class="label ours above" style={`left: ${at(4.89, 0, 10)}`}>ro-mono-303 4.89</span>
<span class="dot" style={`left: ${at(2.39, 0, 10)}`}></span>
<span class="label below from" style={`left: ${at(2.39, 0, 10)}`}>real, retaken 2.39</span>
<span class="dot" style={`left: ${at(9.76, 0, 10)}`}></span>
<span class="label below to" style={`left: ${at(9.76, 0, 10)}`}>schematic only 9.76</span>
</div>
</div>

<div class="measure">
<div class="figure">
<div class="big">5.5 %</div>
<div class="what">median error in the resonant peak</div>
<div class="dim small">Roland's TB-303 software, measured the same way: 21 %.</div>
</div>
<div class="chart" aria-hidden="true">
<div class="axis"></div>
{ticks(0, 25, 5, (v) => `${v} %`).map((t) => <><span class="tick" style={`left: ${t.left}`}></span><span class="tick-label" style={`left: ${t.left}`}>{t.label}</span></>)}
<span class="bar" style={`width: ${at(5.5, 0, 25)}`}></span>
<span class="dot ours" style={`left: ${at(5.5, 0, 25)}`}></span>
<span class="label ours above from" style={`left: ${at(5.5, 0, 25)}`}>ro-mono-303 5.5 %</span>
<span class="dot" style={`left: ${at(21, 0, 25)}`}></span>
<span class="label below to" style={`left: ${at(21, 0, 25)}`}>Roland's software 21 %</span>
</div>
</div>

<div class="measure">
<div class="figure">
<div class="big">±1 ¢</div>
<div class="what">pitch error over five octaves</div>
<div class="dim small">C1 to C5, factory trim. Roland's TB-303 software: −7 to +8 ¢.</div>
</div>
<div class="chart range" aria-hidden="true">
<span class="zero"></span>
<span class="label ours" style={`left: ${at(-1, -10, 10)}; top: 0`}>ro-mono-303 −1 to +1 ¢</span>
<span class="span ours" style={`left: ${at(-1, -10, 10)}; width: 10%; top: 18px`}></span>
<span class="label" style={`left: ${at(-7, -10, 10)}; top: 32px`}>Roland's software −7 to +8 ¢</span>
<span class="span" style={`left: ${at(-7, -10, 10)}; width: 75%; top: 50px`}></span>
<div class="axis"></div>
{ticks(-10, 10, 5, cents).map((t) => <><span class="tick" style={`left: ${t.left}`}></span><span class="tick-label" style={`left: ${t.left}`}>{t.label}</span></>)}
</div>
</div>
</div>
</div>
</section>

<section id="service" class="sheet">
<div class="col sec">
<div class="service-head">
<div class="text">
<h2 class="h2 tap">Take the panel off</h2>
<p class="dim">The main board and switch board, every part where the service notes draw it, with the six trimmers and a scope, frequency counter and meter on each one's test point. <a href="/ro-mono-303/guide#service">SERVICE in the guide</a></p>
</div>
<div class="stamp">
<div><span class="count">16 / 16</span> <span class="spec">In spec</span></div>
<div class="checks">service-note checks</div>
<div class="dim tiny">e.g. two octaves at 4.0005 : 1, spec 4 : 1 ± 0.5 %</div>
</div>
</div>
<figure class="shot">
<div class="mount">
<img src="/media/ro-mono-303/service.webp" alt="ro-mono-303 with SERVICE on: the TB-303's main board and switch board, TM3 FREQ highlighted, a scope timing the filter's ring at TP6, a frequency counter on the VCO, a meter on CV OUT, and the six trimmers, all green: in spec" width="2400" height="1216" loading="lazy">
</div>
<figcaption class="caption"><div class="row"><span class="fig">FIG. 2</span><span><span class="mono">TM3</span> FREQ selected: the scope times the filter's ring at <span class="mono">TP6</span>. Green on a trimmer's track is the service notes' spec.</span></div></figcaption>
</figure>
</div>
</section>

<section id="differences" class="sheet">
<div class="col sec">
<h2 class="h2 tap red">What is still different</h2>
<dl class="diffs">
<div><dt>Accented low notes</dt><dd>Low in CUT OFF, both real units lose a band around 260–330 Hz on accented notes, up to 16 dB on one harmonic, that ro-mono-303 keeps. Plain notes match.</dd></div>
<div><dt>The accent's sweep</dt><dd>Fitted to one unit at one setting, ACCENT and RESONANCE full. There its accents peak within −70 to +30 cents of the real ones.</dd></div>
<div><dt>Loud accents</dt><dd>Both real units flatten their loudest accents; the BA662 VCA chip, as reverse engineered, doesn't. Its output is limited to match, but why the real chip does this isn't known.</dd></div>
<div><dt>The start of a note</dt><dd>Against Din Sync's unit, brightness in the first 0.1 s is about 25 % off. Two takes of that unit differ by about 2 %.</dd></div>
<div><dt>Units differ</dt><dd>With CUT OFF and RESONANCE full, Din Sync's unit tops out at about 1.4 kHz; Whittle gives about 2.5 kHz as typical. CUT OFF MAX (1.2 to 3 kHz) and the SERVICE trimmers cover the spread.</dd></div>
</dl>
<div id="help" class="help">
<div class="help-text">
<h3 class="h3">Own a TB-303?</h3>
<p>Recordings of real units close these gaps and go into blind A/B tests here, published under CC BY 4.0 with your name.</p>
</div>
<a href="/ro-mono-303/record" class="btn red">What to record</a>
</div>
</div>
</section>

<section id="made" class="sheet">
<div class="col sec">
<h2 class="h2 tap">How it was made</h2>
<ol class="steps">
<li>
<div class="step-n">01</div>
<div class="step">
<h3 class="h3">Schematic and SPICE</h3>
<p class="dim">Each block of the voice was modelled from the schematic in the service notes, then compared with an ngspice simulation of the same circuit, with typical part values and at both ends of their tolerance. The whole voice's note level is within 0.1–0.3 dB of the simulation.</p>
</div>
</li>
<li>
<div class="step-n">02</div>
<div class="step">
<h3 class="h3">Calibration to a real unit</h3>
<p class="dim">The schematic doesn't fix trimmer settings, transistor gain or potentiometer taper. These were fitted to <a href="http://www.dinsync.info/2010/02/tb-303-reference-recordings-for-x0xb0x.html">Din Sync's TB-303 reference recordings</a>, 400 notes from a real TB-303 at documented knob positions, with each value kept within its part's tolerance.</p>
<div class="table-box">
<table class="table fitted">
<thead><tr><th scope="col">Part</th><th scope="col">Schematic value</th><th scope="col" class="fit">Fitted</th></tr></thead>
<tbody>
<tr><td>Filter trimmer TM3, ring period</td><td class="num dim">2.0 ms</td><td class="num fit">2.5 ms</td></tr>
<tr><td>Resonance-loop transistor gain</td><td class="num dim">300</td><td class="num fit">385</td></tr>
<tr><td>Filter envelope peak</td><td class="num dim">10 V</td><td class="num fit">9.3 V</td></tr>
<tr><td>DECAY potentiometer</td><td class="num dim">1 MΩ</td><td class="num fit">860 kΩ</td></tr>
<tr><td>Potentiometer taper</td><td class="num dim">exponential</td><td class="num fit">two linear segments</td></tr>
<tr><td>VCA control offset</td><td class="num dim">0 mV</td><td class="num fit">−80 mV</td></tr>
<tr><td>VCA output swing</td><td class="num dim">±4.5 V</td><td class="num fit">±1 V</td></tr>
<tr><td>Accent-sweep gang of the RESONANCE pot</td><td class="num dim">50 kΩ</td><td class="num fit">37.5 kΩ</td></tr>
<tr class="total"><td>Distance from the real unit</td><td class="num">9.76</td><td class="num fit">4.89</td></tr>
</tbody>
</table>
</div>
<p class="dim small">The largest correction is the taper: with the schematic's exponential taper, the model is about an octave too bright with the controls at maximum. The last three values were fitted to how notes start and accents peak, on both units.</p>
</div>
</li>
</ol>
</div>
</section>

<section id="roland" class="sheet">
<div class="col sec">
<div class="text">
<h2 class="h2 tap">Roland's TB-303 software</h2>
<p class="dim">Measured against the same 400 real notes, with the same MIDI and knob positions, using its "Simple Saw" patch with no drive or delay.</p>
</div>
<div class="table-box">
<table class="table versus">
<caption>Mean difference from the real unit, saw / square. Lower is closer. ¢ = cents.</caption>
<thead><tr><th scope="col"><span class="sr">Source</span></th><th scope="col">Spectrum</th><th scope="col">Brightness, first 0.1 s</th><th scope="col">Brightness, later</th><th scope="col">Resonant peak</th><th scope="col">Level</th></tr></thead>
<tbody>
<tr class="dim"><th scope="row">Real unit, retaken</th><td class="num">2.5 / 2.2 dB</td><td class="num">41 / 60 ¢</td><td class="num">33 / 30 ¢</td><td class="num">95 / 43 ¢</td><td class="num">0.1 dB</td></tr>
<tr class="ours"><th scope="row" class="mono">ro-mono-303</th><td class="num">2.9 / 2.9 dB</td><td class="num">388 / 410 ¢</td><td class="num">184 / 174 ¢</td><td class="num">148 / 135 ¢</td><td class="num">0.8 dB</td></tr>
<tr><th scope="row">Roland's software</th><td class="num">3.3 / 3.3 dB</td><td class="num">718 / 812 ¢</td><td class="num">374 / 326 ¢</td><td class="num">385 / 333 ¢</td><td class="num">1.8 / 1.6 dB</td></tr>
</tbody>
</table>
</div>
<p class="dim">Note by note, ro-mono-303 is the closer of the two on 70–89 % of notes, depending on the measure. ro-mono-303 was calibrated on these recordings; Roland's software wasn't.</p>
<p class="dim small">Measured with Roland's TB-303 software 1.0.9, KEYBOARD on, POSITION LOCK off.</p>
</div>
</section>

<section id="rom" class="sheet">
<div class="col sec last">
<h2 class="h2 tap">ROM image and voice mode</h2>
<p class="dim">The sequencer is a program in the CPU's 2 KB mask ROM, Roland's copyrighted work, so it isn't included. With the ROM image, <span class="mono">d650c-133.ic8</span> from MAME's tb303 set, ro-mono-303 runs it on an emulated CPU. Without it, ro-mono-303 runs in voice mode: the same voice over MIDI, with no sequencer. <a href="/ro-mono-303/guide#first-start">The ROM, voice mode and artwork</a></p>
</div>
</section>

</Base>

<script>
// Underline the strip's link for the section being read: the last whose top has passed under the
// strip, or the last of all at the foot of the page.
const links = [...document.querySelectorAll<HTMLAnchorElement>('.onpage a')];
const targets = links.map((a) => document.getElementById(a.hash.slice(1))!);
let current = -2;
function mark() {
  let i = -1;
  targets.forEach((t, j) => { if (t.getBoundingClientRect().top <= 80) i = j; });
  if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) i = targets.length - 1;
  if (i === current) return;
  current = i;
  links.forEach((a, j) => { if (j === i) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
  links[i]?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
}
let frame = 0;
const later = () => { if (!frame) frame = requestAnimationFrame(() => { frame = 0; mark(); }); };
addEventListener('scroll', later, { passive: true });
addEventListener('resize', later);
mark();
</script>

