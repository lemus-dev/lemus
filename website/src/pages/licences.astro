---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Stub from '../components/Stub.astro';

// The same notices every plugin carries (tools/release/NOTICES.txt in the repo).
const notices = fs.readFileSync(path.resolve(process.cwd(), '../tools/release/NOTICES.txt'), 'utf8');
---
<Base title="Licences · Lemus" description="Licences of Lemus and the software it uses." current="licences">
<Stub heading="Credits and licences">
<p>Lemus is free software under the GNU Affero General Public License, version 3; its source is at <a href="https://github.com/lemus-dev/lemus">github.com/lemus-dev/lemus</a>. The plugins include the third-party software and fonts below, under these licences.</p>
<pre style="margin: 0; padding: 20px 24px; background: var(--paper2); border: 1.5px solid var(--ink); font-family: var(--mono); font-size: 13px; line-height: 1.6; color: var(--ink2); white-space: pre-wrap; overflow-wrap: anywhere; max-width: 80ch">{notices}</pre>
</Stub>
</Base>
