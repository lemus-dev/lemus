---
// A drawing's title block. The page's disclaimer goes in the slot; without one, the general one
// is used.
import MailForm from './MailForm.astro';
import { machines } from '../data/machines';

const custom = Astro.slots.has('default');
const released = machines.filter((m) => m.release);
---
<footer class="frame sheet">
<div class="col block">
<div class="cell">
<div class="lbl">Project</div>
<div class="name"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 15v4M8 9v10M13 3v16M18 11v8"></path></svg>Lemus</div>
<div class="small dim">Legacy Electronic Music Systems</div>
</div>
<div class="cell">
<div class="lbl">Documents</div>
<div class="links"><a href="/download">Download</a><a href="/support">Support</a><a href="/licences">Licences</a><a href="https://github.com/lemus-dev/lemus">Source</a></div>
</div>
<div class="cell">
<div class="lbl">Contact</div>
<a href="mailto:hello@lemusdev.org" class="mail-to">hello@lemusdev.org</a>
</div>
<div class="cell">
<div class="lbl">Latest</div>
{released.map((m) => (
<div><a href={`/${m.slug}`} class="mono slug">{m.slug}</a> {m.release!.version}{m.release!.stage && <> <span class="stage">{m.release!.stage}</span></>}</div>
))}
</div>
<div class="cell wide list">
<div class="lead">
<div class="lbl">Mailing list</div>
<div>Release announcements by email</div>
</div>
<MailForm id="mailing-list-email" small />
</div>
<div class="cell wide">
<div class="lbl">Notice</div>
{custom ? <slot /> : (
<p class="notice">Lemus is an independent project and is not affiliated with or endorsed by the makers of the equipment it emulates. Roland and TB-303 are trademarks of Roland Corporation, used here only to name the original hardware and the software it is compared with.</p>
)}
</div>
</div>
</footer>

<style>
footer { padding-block: 8px 56px; }
.block { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); gap: 1.5px; background: var(--ink); border: 2px solid var(--ink); }
.cell { background: var(--paper); padding: 14px 18px; display: flex; flex-direction: column; gap: 6px; min-width: 0; font-size: 15px; }
.cell .lbl { font-size: 12px; letter-spacing: 0.12em; }
.wide { grid-column: 1 / -1; }
.name { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 700; font-size: 26px; line-height: 1; letter-spacing: 0.1em; text-transform: uppercase; }
.small { font-size: 14px; }
.links { display: flex; flex-wrap: wrap; gap: 2px 16px; }
.mail-to { overflow-wrap: anywhere; }
.slug { font-size: 13px; color: var(--ink); }
.stage { color: var(--red); font-weight: 600; }
.list { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; }
.list .lead { display: flex; flex-direction: column; gap: 6px; }
.list :global(form) { flex: 0 1 460px; }
.notice, .cell :global(p) { margin: 0; font-size: 13px; line-height: 1.55; color: var(--ink2); max-width: 70em; }
@media (max-width: 760px) {
  .block { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
</style>
