---
// Shown next to a pre-release download: what its stage means, and that the installers aren't
// signed yet (/download#installing says how to open them anyway).
import type { Release } from '../data/machines';

interface Props {
  release: Release;
}
const { release } = Astro.props;
const article = release.stage === 'alpha' ? 'an' : 'a';
---
{release.stage && (
<div class="pre">
<div class="head"><span class="tag">{release.stage}</span><span class="what">Version {release.version} is {article} {release.stage}</span></div>
<p>Expect bugs, and changes before 1.0. The installers aren't signed yet, so macOS and Windows warn before opening them. <a href="/download#installing">How to open them</a></p>
</div>
)}

<style>
.pre { box-sizing: border-box; width: 100%; max-width: 560px; border: 1.5px solid var(--red); padding: 14px 18px; display: flex; flex-direction: column; gap: 8px; text-align: left; }
.head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
.tag { padding: 0 8px; border: 1.5px solid var(--red); color: var(--red); font-family: var(--display); font-weight: 700; font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; }
.what { font-weight: 600; font-size: 16px; }
p { margin: 0; font-size: 15px; color: var(--ink2); }
</style>
