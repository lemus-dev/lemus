---
import { machines } from '../data/machines';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const link = 'color: #a9b1d6; text-decoration: none; padding: 12px 0';
const active = 'color: #c0caf5; text-decoration: none; padding: 12px 0; font-weight: 700';
---
<header style="border-bottom: 1px solid #292e42">
<div style="max-width: 1200px; margin: 0 auto; padding: 16px 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px">
<a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: #a9c1ff; font-weight: 700; font-size: 22px; min-height: 44px">
<svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="#7aa2f7" stroke-width="2" stroke-linecap="round"><path d="M3 15v4M8 9v10M13 3v16M18 11v8"></path></svg>
Lemus</a>
<nav aria-label="Main" style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px 24px; font-size: 14px">
<a href="/#plugins" style={link}>Plugins</a>
<a href="/#how" style={link}>About</a>
{machines.filter((m) => m.nav).map((m) => (
<a href={`/${m.slug}`} style={current === m.slug ? active : link} aria-current={current === m.slug ? 'page' : undefined}>{m.slug}</a>
))}
<a href="/support" style={current === 'support' ? active : link}>Support</a>
<a href="/download" style="background: #7aa2f7; color: #16161e; text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 8px; min-height: 44px; box-sizing: border-box; display: inline-flex; align-items: center">Download</a>
</nav>
</div>
</header>
