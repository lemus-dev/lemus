---
// The balloon of a control outlined in a Shot, for the text that refers to it.
interface Props {
  n: string | number;
}
const { n } = Astro.props;
---
<span class="num">{n}</span>

<style>
.num { display: inline-block; min-width: 22px; height: 22px; padding: 0 5px; box-sizing: border-box; border: 1.5px solid var(--wire); border-radius: 999px; background: var(--paper); color: var(--wire-text); font: 700 11px/19px var(--mono); text-align: center; vertical-align: 1px; }
</style>
