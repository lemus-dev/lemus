---
// A plain page: a heading tapped off the bus and whatever the page puts in the slot.
interface Props {
  heading: string;
}
const { heading } = Astro.props;
---
<section class="sheet">
<div class="col stub">
<h1 class="h1 tap">{heading}</h1>
<slot />
</div>
</section>

<style>
.stub { padding-block: 72px 112px; display: flex; flex-direction: column; gap: 24px; }
.stub > :global(p) { margin: 0; color: var(--ink2); max-width: 46em; }
</style>
